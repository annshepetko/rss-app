# Keycloak Docker Compose configuration
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# CommaFeed Keycloak Backend Integration
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=commafeed
KEYCLOAK_CLIENT_ID=commafeed-service
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_CONNECT_TIMEOUT=5s
KEYCLOAK_REQUEST_TIMEOUT=5s
